# Copie para .env apenas se precisar alterar algo localmente. Nenhum segredo é necessário.
# Porta HTTP (o Railway define PORT automaticamente).
PORT=3000
# Número exibido na primeira sessão criada ("Sessão N"). Sequencial a partir daqui.
SESSION_NUMBER_START=1
# Limite de sessões simultâneas mantidas em memória.
MAX_SESSIONS=200
